<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gym.project.gym.mapper.GymCommodityMapper">
    
    <resultMap type="GymCommodity" id="GymCommodityResult">
        <result property="commodityId"    column="commodity_id"    />
        <result property="commodityName"    column="commodity_name"    />
        <result property="commodityPrice"    column="commodity_price"    />
        <result property="commodityNumber"    column="commodity_number"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectGymCommodityVo">
        select commodity_id, commodity_name, commodity_price, commodity_number, remark from gym_commodity
    </sql>

    <select id="selectGymCommodityList" parameterType="GymCommodity" resultMap="GymCommodityResult">
        <include refid="selectGymCommodityVo"/>
        <where>  
            <if test="commodityName != null  and commodityName != ''"> and commodity_name like concat('%', #{commodityName}, '%')</if>
            <if test="commodityPrice != null "> and commodity_price = #{commodityPrice}</if>
            <if test="commodityNumber != null "> and commodity_number = #{commodityNumber}</if>
        </where>
    </select>
    
    <select id="selectGymCommodityByCommodityId" parameterType="Long" resultMap="GymCommodityResult">
        <include refid="selectGymCommodityVo"/>
        where commodity_id = #{commodityId}
    </select>
        
    <insert id="insertGymCommodity" parameterType="GymCommodity" useGeneratedKeys="true" keyProperty="commodityId">
        insert into gym_commodity
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="commodityName != null">commodity_name,</if>
            <if test="commodityPrice != null">commodity_price,</if>
            <if test="commodityNumber != null">commodity_number,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="commodityName != null">#{commodityName},</if>
            <if test="commodityPrice != null">#{commodityPrice},</if>
            <if test="commodityNumber != null">#{commodityNumber},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateGymCommodity" parameterType="GymCommodity">
        update gym_commodity
        <trim prefix="SET" suffixOverrides=",">
            <if test="commodityName != null">commodity_name = #{commodityName},</if>
            <if test="commodityPrice != null">commodity_price = #{commodityPrice},</if>
            <if test="commodityNumber != null">commodity_number = #{commodityNumber},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where commodity_id = #{commodityId}
    </update>

    <delete id="deleteGymCommodityByCommodityId" parameterType="Long">
        delete from gym_commodity where commodity_id = #{commodityId}
    </delete>

    <delete id="deleteGymCommodityByCommodityIds" parameterType="String">
        delete from gym_commodity where commodity_id in 
        <foreach item="commodityId" collection="array" open="(" separator="," close=")">
            #{commodityId}
        </foreach>
    </delete>
</mapper>