/* coaches-detail.wxss */

.container {
  min-height: 100%;
  justify-content:space-between;
  align-items: center;
}
.row-wrap{
    width: 100%;
    line-height: 88rpx;
    margin-left: 30rpx;
    border-bottom: 1rpx solid #eee;
    display: flex;
    font-size: 28rpx;
    /*justify-content: space-between;*/
}
.row-wrap .label{
    color: #000
}
.row-wrap .label-right{
    flex: 1;
    height: 88rpx;
    line-height: 88rpx;
}
.row-wrap .label-right input{
    height: 100%;
    font-size: 28rpx;
    padding-right: 30rpx;
}
.row-wrap .right-box{
    margin-right: 30rpx;
}

.picker {
    width:160rpx;
    height: 60rpx;
    background-color: #000;
    font-size: 15px;
    border-radius: 30rpx;
    text-align: center;
    color: #fff;
    margin:15rpx 15rpx;
    line-height:60rpx;
}

.hui{
    color: #ccc;
}

.item-coach {
    width: 100%;
    display: inline-block;
    border-radius: 5%;
}
.img{
    width: 40rpx;
    height:40rpx;
}

.zan-font-12-bold {
  position: relative;
  display: flex;
  align-items: center;
  font-size: 22px;
  font-weight:bold;
  flex-direction: row;
  text-align: center;
  margin:0 25%;
}

.zan-font-10 {
  position: relative;
  padding: 10px 20px;
  display: flex;
  align-items: center;
  font-size: 25px;
}
.coach-dest{
  background-color: #000;
  color: #fff;
  width:100%;
}

.coach{
  align-items: center;
}

.type-container{
  width: 100%;
  height: 88rpx;
  background-color: #fff;
  overflow: hidden;
}

.type-navbar{
  white-space: nowrap;
  display: flex;
  height: 88rpx;
  background-color: #fff;
}

.type-box{
  width:160rpx;
  box-sizing: content-box;
  font-size: 24rpx;
  line-height: 84rpx;
  text-align: center;
  display: inline-block;
  overflow: hidden;
}

.type-navbar-item{
  border-bottom: 4rpx solid #fff;
}
.type-item-on{
  border-bottom: 4rpx solid #e64340;
}

.zan-cell {
  position: relative;
  padding: 12px 15px;
  display: flex;
  align-items: center;
  line-height: 1.4;
  font-size: 10px;
}
.picker{
    margin-left:25%;
}
.num{
    margin-top: 3%;
}
.zan-cell::after {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  border-top: 1rpx solid #e5e5e5;
  background: #e5e5e5;
  content: ' ';
}
.zan-cell__bd {
    flex: 1;
    color: #6ae640;
    font-size: 20px;
    min-width: fit-content;
}

.zan-panel {
  background: #fff;
  /*border-top: 1rpx solid #e5e5e5;*/
  border-bottom: 1rpx solid #e5e5e5;
  overflow: hidden;
  width:100%;
  border-radius:10rpx;
}

.appointBtn{
    width: 200rpx;
    height: 200rpx;
    color: #000;
    font-size: 15px;
    font-weight: bold;
    margin-top:30rpx;
    line-height:200rpx;
    text-align: center;
}
.border-radius {
    border-radius: 50%;
    position: relative;
    left: 0;
    top: 0;
    color: #fff;
}
.pink-bg {
    background-color: #000;
}
.footer-box{
    width: 140%;
    height: 100rpx;
    background-color: #fff;
    position: fixed;
    bottom: 0;
    left: 0;
    display: flex;
    box-shadow:0 0 8rpx 0 ;
}
.footer-box .shop-cart-btn{
    position: relative;
    width: 150rpx;
    height: 100%;
    line-height: 100rpx;
    text-align: center;
    padding-top: 26rpx;
    font-size:20rpx;
    color:#acacb7;
    box-sizing: border-box;
    background-size: 44rpx auto;
}
.footer-box .shop-cart-btn .shop-num{
    position: absolute;
    color:#e64340;
    font-size: 20px;
    left:0;
    top:-20rpx;
}
.footer-box .join-shop-cart{
    text-align: center;
    width: 25%;
    line-height: 100rpx;
    background-color: #ff6850;
    color:#fff;
    font-size: 34rpx;
}
.footer-box .now-buy{
    text-align: center;
    height: 100%;
    width: 33%;
    line-height: 100rpx;
    background-color: #e64340;
    color:#fff;
    font-size: 34rpx;
}
.showBtn {
    margin-top: 10%;
    width: fit-content;
    background-color: #7bcbe3;
    margin-bottom: 0;
}
/* 是否显示 */
.modal_show {
    display: block;
}
.modal_hide {
    display: none;
}

/* 日期弹出框 */
.modal {
    position: fixed;
    z-index: 999;
    bottom: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.3);
}

/* 背景模板*/
.modal_cancel {
    position: absolute;
    top: 0;
    width: 100%;
    height: 100%;
}
/* 弹出框主体 */
.modal_container {
    position: absolute;
    bottom: 0;
    width: 100%;
    height: auto;
    background: #fff;
}

/* modal_header */
.modal_header {
    padding: 20rpx;
    text-align: center;
    font-size: 11pt;
}
/* header_tip */
.header_tip {
    position: relative;
    font-size: 15px;
    color: #999;
}

/* time日期主体view */
.time {
    background: #f7f7f7;
    text-align: center;
    font-size: 11pt;
}
/* time日期主体滚动view */
.time_scroll {
    white-space: nowrap;
    width: 100%;
    height:100rpx;
    line-height:50rpx;
}

.scroll-view-item {
    height: 100rpx;
}
/* 日期 */
.scroll_item {
    display: inline-block;
    padding: 0 40rpx;
    height: 100rpx;
    box-sizing: border-box;
}

/* time_active选择状态 */
.time_active {
    color: #e31515;
    border-bottom: 4rpx solid #1537e3;
}

/* 时间 */
.hour {
    padding: 20rpx 0 0 20rpx;
}

.hour_item {
    width: 22%;
    box-sizing: border-box;
    height: 70rpx;
    line-height: 70rpx;
    border-radius: 10rpx;
    text-align: center;
    float: left;
    border: 2rpx solid #eee;
    font-size: 11pt;
    margin-right: 3%;
    margin-bottom: 20rpx;
}

/* hour_active*/

.hour_active {
    background: #e31515;
    color: #fff;
    border: 2rpx solid #72e315;
}

/* hour_unactive */

.hour_unactive {
    color: #999;
}
