.page {
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
    background-color: black;
    color: white;
    padding: 20rpx;
}

.user-info {
    background-color: red;
    padding: 20rpx;
}

.head-img {
    display: flex;
    align-items: center;
}

.thumb {
    width: 50rpx;
    height: 50rpx;
    border-radius: 50%;
    margin-right: 10rpx;
}

.name {
    font-size: 16px;
    font-weight: 600px;
}
.picture-text{
    display: block;
    margin-left: 30%;
}
.picture-image{
    margin-left: 30%;
    width: 150px;
    height: 150px;
    border-radius: 50%;
    margin-right: 10rpx;
    margin-top: 3%;
}
.form-section {
    margin: 20rpx 0 20rpx;
    font-size: 20px;
}

.form-label {
    display: block;
    font-size: 20px;
    margin-bottom: 10rpx;
}
.divLine{
    background: #E0E3DA;
    width: 100%;
    height: 5rpx;
}
.resetpwd{
    background-color: darkgray;
    width: 90%;
    border-radius: 5px;
    padding: 2px 5px 2px 5px;
}
.title{
    font-size: 25px;
    font-family: Bahnschrift;
    margin-bottom: 10rpx;
    color: red;
    margin-left: 38%;
}

.form-input {
    width: 90%;
    font-size: 20px;
    padding: 10rpx;
    margin-left: 2%;
    margin-right: 3%;
    border: none;
    border-radius: 5rpx;
    background-color: #333;
    color: white;
}

.goal-fields {
    display: flex;
    align-items: center;
}

.update-button {
    width: 100%;
    font-size: 32rpx;
    padding: 10rpx;
    border: none;
    border-radius: 5rpx;
    background-color: red;
    color: white;
}
