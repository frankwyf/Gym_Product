/* pages/post-details.wxss */
.container {
    padding: 20rpx;
    background-color: #000;
    color: #fff;
}

.header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20rpx;
}

.title {
    font-size: 32rpx;
    font-weight: bold;
}

.send-button {
    width: 100%;
    height: 100rpx;
    margin-top: 25%;
    background-color: #ff0000;
    color: #fff;
    font-size: 25px;
    border: none;
    border-radius: 10rpx;
    cursor: pointer;
}

.date {
    font-size: 20px;
    color: aquamarine;
    border: solid 1px red;
    padding: 2px 2px 2px 2px;
    border-radius: 5px;
    margin-top: 10px;
}

.date1 {
    color: #9bff7f;
    border: solid 1px red;
    padding: 2px 2px 2px 2px;
    border-radius: 5px;
    margin-top: -20px;
    float: right;
    margin-left: 90%;
}

.content {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.image {
    width: 100%;
    height: 500rpx;
    margin-bottom: 20rpx;
}

.author {
    font-size: 28rpx;
    margin-bottom: 10rpx;
}

.text {
    margin-top: 20px;
    font-size: 24px;
    text-align: justify;
    color: ghostwhite;
}


.comment-section {
    margin-top: 30rpx;
}

.comment-list {
    margin-top: 20rpx;
}

.comment-item {
    font-size: 24rpx;
    line-height: 36rpx;
    margin-bottom: 10rpx;
    margin-top: 18px;
}

.comment-content {
    font-weight: bold;
    font-size: 18px;
    margin-left: 10px;
    margin-right: 10px;
}

.divLine{
    background: #E0E3DA;
    width: 100%;
    height: 5rpx;
}
.comment-title{
    font-size: 20px;
    font-family: "Arial Black";
    margin-bottom: 20px;
}
.comment-author {
    font-size: 18px;
    color: #999;
    margin-top: 10rpx;
    border: aquamarine solid 1px;
    padding: 2px 2px 2px 2px;
    border-radius: 5px;
}

.comment-input-container {
    margin-top: 35%;
    display: flex;
    flex-direction: row;
    align-items: center;
    min-width: 100%;
}

.comment-input {
    flex: 1;
    padding: 10rpx;
    font-size: 24px;
    border: 1rpx solid #ccc;
    border-radius: 5rpx;
}

.comment-button {
    margin-left: 2%;
    font-size: 18px;
    background-color: #007AFF;
    color: #fff;
    border-radius: 5rpx;
}
