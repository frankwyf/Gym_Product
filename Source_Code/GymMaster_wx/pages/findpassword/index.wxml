<view class="content">
    <image class="bg-image" mode="scaleToFill"  src="../../images/login_background.jpg"></image>
    <view class = "logo">
        <image mode="aspectFit" src="/images/gym_logo.jpg" style="width:120px;height:120px;border-radius: 5px;"></image>
    </view>
    <form bindsubmit="formSubmit">
        <view class="input-area">
            <input id="username" name="username" maxlength='50' type="text"  placeholder=" Your Username" bindchange="getUsername"/>
          <input id="username" name="email" maxlength='50' type="text"  placeholder=" Your E-mail" bindchange="getPhoneNum" />
          <view class="smsCode">
            <input id="smsCode" name="smsCode" maxlength='6' type="text" placeholder=" Verify code" />
            <button bindtap = "getSmsCode" disabled="{{smsCodeDisabled}}" style="background-color:{{getSmsCodeBtnColor}}"   class="getSmsCodeBtn">{{getSmsCodeBtnTxt}}</button>
          </view>
          <input id="password" name="password" maxlength='20' type="password" placeholder=" New Password" />
            <input id="password" name="confirmPwd" maxlength='20' type="password" placeholder=" Confirm Password" />
        </view>
        <view class="btn-area">
            <button  disabled="{{registDisabled}}" style="background-color:{{registBtnBgBgColor}}"   formType="submit"  loading="{{btnLoading}}"> {{registBtnTxt}} </button>
            <view class="txt-area">
                 <navigator redirect url="../regist/index"><text class="forgot-password">Register now !</text></navigator>
                 <navigator redirect url="../login/index"><text class="register">Login now</text></navigator>
            </view>
        </view>
    </form>

    <!--<progress class="myprogress" percent="{{percent }}" color="{{color}}" active/>-->

</view>
