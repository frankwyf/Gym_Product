/*.myprogress{margin:5px 0}*/
page{
    height: 100%;}
.content{text-align: center;
}
.bg-image {
    margin-left: -50%;
    width : 150%;
    height : 100%;
    position: fixed;
    filter: blur(5px);
    z-index: -1;
}
.logo{padding:30px; margin-bottom: 120rpx}
.logo image{width:400rpx;height: 60rpx}
.input-area{
    background-color: #fff;
    text-align: left;
    margin-left: 10%;
    border-bottom:1px solid #ddd;
    border-top:1px solid #ddd;
    width: 80%;
    border-radius: 5px;
}
.input-area input{height:100rpx;line-height: 100rpx;}
#username{border-bottom:1px solid #ddd; padding: 0 5px}
#password{border-bottom:1px solid #ddd; padding: 0 5px}
.btn-area{width: 80%;margin: 0 auto}
.btn-area button{
    /*background-color: #ff9900;*/
    margin-top: 40rpx;
    color: #fff
}
.txt-area{
    margin-top: 30rpx;
    display: flex;
    justify-content:space-between;
    font-size: 30rpx
}
.forgot-password{
    color: #ea2f2f;
    font-family: "Arial Black";
    font-size: 15px;
    background-color: #525252;
    border-radius: 5px;
    padding: 2px 2px 2px 2px;
}
.register{
    color:#1CBCB4;
    font-family: "Arial Black";
    font-size: 15px;
    background-color: #525252;
    border-radius: 5px;
    padding: 2px 2px 2px 2px}
.forgot-password:active,.register:active{opacity: 0.7}
