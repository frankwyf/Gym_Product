<view class="container">
    <view class="navbar">
        <view class="nav-item {{activeTab==0?'active':''}}" bindtap="switchTab" data-index="0">Unpaid</view>
        <view class="nav-item {{activeTab==1?'active':''}}" bindtap="switchTab" data-index="1">Paid</view>
        <view class="nav-item {{activeTab==2?'active':''}}" bindtap="switchTab" data-index="2">Bills</view>
    </view>
    <view class="content">
        <!-- Unpaid Reservations -->
        <view wx:if="{{activeTab==0}}">
            <view class="title">Unpaid Reservations</view>
            <view class="reservation-status1">Tap to view Details</view>
            <view class="reservation-list">
                <view class="reservation-item" wx:for="{{unpaidReservations}}" bindtap="showModalun" data-item="{{item}}" >
                    <view class="reservation-info">
                        <view class="reservation-venuenum"> Amount: {{item.amount}}</view>
                        <view class="reservation-period3"> Price to pay: {{item.price}}</view>
                        <view class="reservation-date" wx:if="{{item.period != 0}}"> Start at: {{time[item.period-1]}}</view>
                        <view class="reservation-date" wx:if="{{item.period == 0}}"> Course Reservation</view>
                    </view>
                    <view class="reservation-status2">Unpaid</view>
                </view>
                <text class="nomore">no more data</text>
            </view>
        </view>
        <view class="modal" wx:if="{{isModalShowun}}">
            <view class="modal-mask" bindtap="hideModalun"></view>
            <view class="modal-content">
                <view class="reservation-info">
                    <image class="modal-image" src="{{server}}{{modalItemun.type}}/{{modalItemun.pic}}"></image>
                    <view class="reservation-venuenum"> Amount: {{modalItemun.amount}}</view>
                    <view class="reservation-period"> Date: {{modalItemun.date}}</view>
                    <view class="reservation-venuenum"> Name: {{modalItemun.name}}</view>
                    <view class="reservation-period3"> Price to pay: {{modalItemun.price}}</view>
                    <view class="reservation-date" wx:if="{{modalItemun.period != 0}}"> Start at: {{time[modalItemun.period-1]}}</view>
                    <view class="reservation-date" wx:if="{{modalItemun.period == 0}}"> Course Reservation</view>
                </view>
            </view>
        </view>
        <!-- Paid Reservations -->
        <view wx:if="{{activeTab==1}}">
            <view class="title">Paid Reservations</view>
            <view class="reservation-status1">Tap to view QR code</view>
            <view class="reservation-list">
                <view class="reservation-item" wx:for="{{paidReservations}}" bindtap="showModal" data-item="{{item}}" >
                    <view class="reservation-info">
                        <view class="reservation-venuenum">Reservation ID: {{item.rid}}</view>
                        <view class="reservation-period"> Date: {{item.rdate}}</view>
                        <view class="reservation-date" wx:if="{{item.period != 0}}"> Start at: {{time[item.period-1]}}</view>
                        <view class="reservation-date" wx:if="{{item.period == 0}}"> Course Reservation</view>
                    </view>
                    <view class="reservation-status">Paid</view>
                </view>
                <text class="nomore">no more data</text>
            </view>
        </view>
        <!-- Modal for reservation Qr code-->
        <view class="modal" wx:if="{{isModalShow}}">
            <view class="modal-mask" bindtap="hideModal"></view>
            <view class="modal-content">
                <image class="qr-code" src="{{server}}reservationQR/{{modalItem.rid}}.jpg"></image>
                <view class="reservation-info">
                    <view class="reservation-facilitynum">Facility num: {{modalItem.facility}}</view>
                    <view class="reservation-venuenum">Venue num: {{modalItem.venue}}</view>
                    <view class="reservation-period" wx:if="{{modalItem.period != 0}}" >Start at: {{time[modalItem.period-1]}}</view>
                    <view class="reservation-date"> Date: {{modalItem.rdate}}</view>
                </view>
            </view>
        </view>

        <!-- Bills -->
        <view wx:if="{{activeTab==2}}">
            <view class="title">Bills</view>
            <button class="Sendall" bindtap="sendAll">Send all bills to E-mail</button>
            <view class="bill-list">
                <view class="bill-item" wx:for="{{bills}}">
                    <view class="bill-info">
                        <view class="reservation-facilitynum">Facility: {{item.fname}}</view>
                        <view class="reservation-venuenum">Venue: {{item.vname}}</view>
                        <view class="reservation-period3">Total price: {{item.figure}} ￡</view>
                        <view class="reservation-date">{{filter.format(item.bdate, 'yyyy/MM/dd hh:ss:mm')}}</view>
                    </view>
                    <view class="bill-operator">{{item.operator}}</view>
                    <button class="send-to-server" bindtap="sendToServer" data-bid="{{item.bid}}">Email</button>
                </view>
                <text class="nomore">no more data</text>
            </view>
        </view>
    </view>
</view>

<wxs module="filter">
    function format(ts, option) {
        var date = getDate(ts)
        var year = date.getFullYear()
        var month = date.getMonth() + 1
        var day = date.getDate()
        var week = date.getDay()
        var hour = date.getHours()
        var minute = date.getMinutes()
        var second = date.getSeconds()

        // year month day
        if (option == 'YY-MM-DD') return [year, month, day].map(formatNumber).join('/')

        // year month
        if (option == 'YY-MM') return [year, month].map(formatNumber).join('/')

        // year
        if (option == 'YY') return [year].map(formatNumber).toString()

        // month
        if (option == 'MM') return  [mont].map(formatNumber).toString()

        // day
        if (option == 'DD') return [day].map(formatNumber).toString()

        // year month day and week
        if (option == 'YY/M/DD Week')  return [year, month, day].map(formatNumber).join('/') + ' ' + getWeek(week)

        // month day and week
        if (option == 'MM/DD Week')  return [month, day].map(formatNumber).join('/') + ' ' + getWeek(week)

        // week
        if (option == 'Week')  return getWeek(week)

        // hour minutes and seconds
        if (option == 'hh-mm-ss') return [hour, minute, second].map(formatNumber).join(':')

        // hour and seconds
        if (option == 'hh-mm') return [hour, minute].map(formatNumber).join(':')

        // minutes and seconds
        if (option == 'mm-dd') return [minute, second].map(formatNumber).join(':')

        // hour
        if (option == 'hh')  return [hour].map(formatNumber).toString()

        // minutes
        if (option == 'mm')  return [minute].map(formatNumber).toString()

        // seconds
        if (option == 'ss') return [second].map(formatNumber).toString()

        // return value: yyyy-mm-dd : hh-mm-ss.sss
        return [day, month, year].map(formatNumber).join('/') + ' ' + [hour, minute, second].map(formatNumber).join(':')
    }

    function formatNumber(n) {
        n = n.toString()
        return n[1] ? n : '0' + n
    }

    function getWeek(n) {
        switch(n) {
            case 1:
                return 'Monday'
            case 2:
                return 'Tuesday'
            case 3:
                return 'Wednesday'
            case 4:
                return 'Thursday'
            case 5:
                return 'Friday'
            case 6:
                return 'Saturday'
            case 7:
                return 'Sunday'
        }
    }
    module.exports.format = format;
</wxs>
