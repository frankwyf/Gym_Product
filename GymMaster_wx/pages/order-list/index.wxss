.container {
    background-color: #fff;
    color: #000;
}

.navbar {
    display: flex;
    justify-content: space-around;
    padding: 10px;
    border-bottom: #f3eded 3px solid;
    width: 100%;
}

.nav-item {
    font-size: 18px;
    cursor: pointer;
}
.content{
    border-radius: 5px;
    background-color: #d5cece;
    width: 100%;
}

.active {
    border-bottom: 3px solid #ea0707;
}

.title {
    font-size: 24px;
    font-weight: bold;
    padding: 10px;
    text-align: center;
}

.reservation-list, .bill-list {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 10px;
}

.reservation-item, .bill-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 10px;
    border-bottom: 1px solid #fff;
}

.reservation-info, .bill-info {
    display: flex;
    flex-direction: column;
}

.reservation-name, .reservation-date, .reservation-facilitynum, .reservation-venuenum, .reservation-period, .reservation-date, .bill-date, .bill-amount, .bill-operator {
    font-size: 18px;
}
.reservation-period3{
    color: red;
    font-style: italic;
    font-size: 18px;
    font-family: "Arial Black";
    margin-bottom: 5px;
}
.reservation-facilitynum{
    font-family: "Arial Black";
}
.Sendall{
    width: 80%;
    background-color: #f15617;
}
.nomore{
    color: darkgray;
    font-size: 14px;
    margin-top: 5px;
}
.reservation-status, .bill-operator {
    font-size: 18px;
    font-weight: bold;
    color: #3c9b3c;
    margin-left: 15%;
}
.reservation-status1 {
    display: block;
    font-size: 18px;
    font-weight: bold;
    color: #90ad90;
    margin-left: 28%;
}

.reservation-status2 {
    font-size: 18px;
    font-weight: bold;
    color: #ef0c0c;
}
.bill-item:last-child {
    border-bottom: none;
}
.modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 999;
}

.modal-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background-color: #fff;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.2);
    width: 80%;
}

.qr-code {
    width: 200px;
    height: 200px;
    max-width: 200px;
    display: block;
    margin: 0 auto 20px;
}

.reservation-info {
    font-size: 16px;
    margin-bottom: 10px;
}

.reservation-facilitynum,
.reservation-venuenum,
.reservation-period,
.reservation-date {
    margin-bottom: 5px;
}

.reservation-facilitynum::before,
.reservation-venuenum::before,
.reservation-period::before,
.reservation-date::before {
    content: '';
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-right: 5px;
}

.reservation-facilitynum::before {
    background-color: red;
}

.reservation-venuenum::before {
    background-color: black;
}

.reservation-period::before {
    background-color: red;
}

.reservation-date::before {
    background-color: black;
}
.send-to-server {
    background-color: #4c6baf;
    color: white;
    border: none;
    font-size: 16px;
    cursor: pointer;
    margin-left: 5px;
}

.bill-item button:hover {
    background-color: #3e8e41;
}

