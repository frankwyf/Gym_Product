.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  background-color: white;
  border-radius: 5px;
  padding: 20px;
  display: flex;
  flex-direction: column;
}

.modal-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 10px;
}

.modal-list {
  margin-bottom: 20px;
}

.account-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px;
  margin: 10px;
  border: 1px solid #ccc;
  border-radius: 5px;
  cursor: pointer;
}

.account-info {
  display: flex;
  flex-direction: column;
}

.account-title {
  font-size: 16px;
  font-weight: bold;
}

.account-balance {
  font-size: 14px;
}

.account-method {
  font-size: 18px;
}

.account-method1 {
  font-size: 14px;
  color: green;
}

.account-method2 {
  font-size: 14px;
  color: red;
}

.modal-buttons {
  display: flex;
  justify-content: flex-end;
}

.modal-button {
  margin-left: 10px;
  padding: 5px;
  background-color: #4caf50;
  color: white;
  border: none;
  border-radius: 5px;
  cursor: pointer;
}

.modal-button:last-child {
  background-color: #f44336;
}

