/* coaches-detail.wxss */
.container {
  min-height: 100%;
  justify-content:space-between;
  align-items: center;
}

.row-wrap{
    width: 100%;
    line-height: 88rpx;
    margin-left: 30rpx;
    border-bottom: 1rpx solid #eee;
    display: flex;
    font-size: 28rpx;
    /*justify-content: space-between;*/
}
.row-wrap .label{
    color: #000
}
.row-wrap .label-right{
    flex: 1;
    height: 88rpx;
    line-height: 88rpx;
}
.row-wrap .label-right input{
    height: 100%;
    font-size: 28rpx;
    padding-right: 30rpx;
}
.row-wrap .right-box{
    margin-right: 30rpx;
}

.picker {
    width:160rpx;
    height: 60rpx;
    background-color: #000;
    font-size: 15px;
    border-radius: 30rpx;
    text-align: center;
    color: #fff;
    margin:15rpx 15rpx;
    line-height:60rpx;
}
.article__source{
    color:#d81e06;
    border:1rpx solid #d81e06;
    padding: 2rpx 10rpx 5px;
    border-radius: 4rpx;
    font-size:25rpx;
    margin-right: 20rpx;
}

.hui{
    color: #ccc;
}

.item-coach {
    width: 100%;
    display: inline-block;
    border-radius: 5%;
}
.img{
    width: 40rpx;
    height:40rpx;
}

.zan-font-12-bold {
  position: relative;
  display: flex;
  align-items: center;
  font-size: 22px;
  font-weight:bold;
  flex-direction: row;
  text-align: center;
  margin:0 25%;
    min-width: fit-content;
}

.zan-font-10 {
  position: relative;
  padding: 10px 20px;
  display: flex;
  align-items: center;
  font-size: 25px;
}
.article__desc{
    padding: 7px;
    margin-left: 20%;
    background-color: #a4bcee;
    width: fit-content;
    height: 30px;
    border-radius: 5px;
}
.zan-font-10_1 {
    position: relative;
    padding: 10px 20px;
    display: flex;
    align-items: center;
    font-size: 20px;
}
.coach-dest{
  background-color: #000;
  color: #fff;
  width:100%;
}

.coach{
  align-items: center;
}

.type-container{
  width: 100%;
  height: 88rpx;
  background-color: #fff;
  overflow: hidden;
}

.type-navbar{
  white-space: nowrap;
  display: flex;
  height: 88rpx;
  background-color: #fff;
}

.type-box{
  width:160rpx;
  box-sizing: content-box;
  font-size: 24rpx;
  line-height: 84rpx;
  text-align: center;
  display: inline-block;
  overflow: hidden;
}

.type-navbar-item{
  border-bottom: 4rpx solid #fff;
    min-width: fit-content;
}
.type-item-on{
  border-bottom: 4rpx solid #e64340;
    min-width: fit-content;
}

.zan-cell {
  position: relative;
  padding: 12px 15px;
  display: flex;
  align-items: center;
  line-height: 1.4;
  font-size: 10px;
}

.zan-cell::after {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  border-top: 1rpx solid #e5e5e5;
  background: #e5e5e5;
  content: ' ';
}
.zan-cell__bd {
  flex: 1;
  color: #e64340;
}

.zan-panel {
  background: #fff;
  /*border-top: 1rpx solid #e5e5e5;*/
  border-bottom: 1rpx solid #e5e5e5;
  overflow: hidden;
  width:100%;
  border-radius:10rpx;
}

.appointBtn{
    width: 200rpx;
    height: 200rpx;
    color: #000;
    font-size: 15px;
    font-weight: bold;
    margin-top:30rpx;
    line-height:200rpx;
    text-align: center;
}
.border-radius {
    border-radius: 50%;
    position: relative;
    left: 0;
    top: 0;
    color: #fff;
}
.pink-bg {
    background-color: #000;
}
.type-container{
    width: 100%;
    height: 88rpx;
    background-color: #fff;
    overflow: hidden;
}
.type-navbar{
    white-space: nowrap;
    display: flex;
    height: 88rpx;
    background-color: #fff;
    font-family: "Arial Black";
}
.type-box{
    width:160rpx;
    box-sizing: content-box;
    font-size: 24rpx;
    line-height: 84rpx;
    text-align: center;
    display: inline-block;
    overflow: hidden;
}
.type-navbar-item{
    border-bottom: 4rpx solid #fff;
}

.type-item-on {
    border-bottom: 4rpx solid #e64340;
    min-width: fit-content;
}
.goods-box{
    width: 100%;
    height:100%;
    background-color: #fff;
    margin-bottom: 24rpx;
}
.venue_pic{
    padding: 3%;
    margin-left: 12%;
}
.goods-box .img-box{
    width: 339rpx;
    height: 339rpx;
    overflow: hidden;
}
.goods-box .img-box image{
    width: 339rpx;
    height: 339rpx;
}
.goods-box .goods-title{
    width: 280rpx;
    text-overflow: ellipsis;
    white-space: nowrap;
    overflow: hidden;
    font-size: 24rpx;
    padding: 24rpx 0 0rpx 0;
    color:#000;
    margin-left: 24rpx;
}
.goods-box .goods-price{
    width: 280rpx;
    overflow: hidden;
    font-size: 24rpx;
    padding: 24rpx 0;
    color:#e64340;
    margin-left: 24rpx;
}
navigator {
    display: block;
    padding: 15rpx 0 0;
    width: 100%;
    height: 80rpx;
    line-height: 40rpx;
    text-align: center;
    background-color:#ff0000 ;
    color: #000000;
    font-size: 20px;
    border-radius: 5px;
}

.navigator-hover {
    background-color: #000000;
    color: #ff0000;
}
