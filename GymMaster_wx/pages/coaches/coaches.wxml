<!--coaches.wxml-->
  <view class="zan-toptips {{ zanTopTips.show ? 'zan-toptips--show' : '' }}">{{ zanTopTips.content }}</view>
<view class="container">
  <view class="coach-card" wx:for="{{coaches}}" data-telnumber="{{item.tags}}" bindlongtap="ContactCoachLongTap">
      <view class="coach">
          <image class="item-coach" src="{{server}}coachpro/{{item.profile}}"/>
          <view class="zan-font-12-bold">{{item.username}}</view>
      </view>
      <text class="zan-font-10">{{item.intro}}</text>
      <text class="golden" wx:if="{{item.salary > 5000}}"> Golden Coach </text>
  </view>
</view>
