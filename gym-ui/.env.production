# Production environment — replace placeholders with real values before deploying
NODE_ENV=production

# Admin API base URL — point to your production backend
VUE_APP_BASE_API=https://api.example.com

# GymMaster API base URL — point to your production gymMaster instance
VUE_APP_GYMMASTER_API=https://gym.example.com

# App title
VUE_APP_TITLE=Gym Product Admin

# Enable gzip compression (true/false)
VUE_APP_ENABLE_GZIP=true
