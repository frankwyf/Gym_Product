# Development environment — values are for local development only
NODE_ENV=development

# Admin API base path (proxied by vue.config.js to http://localhost:8080)
VUE_APP_BASE_API=/dev-api

# GymMaster API direct URL (gymMaster backend, port 8087)
VUE_APP_GYMMASTER_API=http://localhost:8087

# App title shown in the browser tab
VUE_APP_TITLE=Gym Product Admin (Dev)

# Enable gzip compression in build (true/false)
VUE_APP_ENABLE_GZIP=false
