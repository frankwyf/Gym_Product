# Copy this file to .env.local and fill in real values for local development.
# Never commit files containing real secrets to version control.

# ── Required ──────────────────────────────────────────────────────────────────

# Base URL path for the gym-admin (gym-management-system-master) backend.
# For local dev this is typically a relative path proxied via vue.config.js.
VUE_APP_BASE_API=/dev-api

# Base URL for the gymMaster backend (Spring Boot, default port 8087).
# Used by the reservation, facility, course, and coach management pages.
VUE_APP_GYMMASTER_API=http://localhost:8087

# ── Optional ──────────────────────────────────────────────────────────────────
VUE_APP_TITLE=Gym Product Admin
VUE_APP_ENABLE_GZIP=false
